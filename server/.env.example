# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it holds live secrets.

# ---- Core ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/gaming-platform
CLIENT_URL=http://localhost:3000

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Razorpay ----
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ---- SMTP / Email ----
# All five are required for outgoing email (OTP, welcome, notifications) to work.
# If any is missing, the app logs a clear warning and skips sending - it never crashes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: force secure true/false instead of inferring it from SMTP_PORT
# (465 = implicit TLS -> true, everything else -> false/STARTTLS). Set this
# to quickly try the other combination (e.g. 465+true) if the host's
# outbound network resets connections on the inferred combo (ESOCKET).
SMTP_SECURE=

# ---- Seed accounts (optional) ----
# Each of the three roles below is checked and created independently, by its
# OWN specific email/username, on every server boot - not just "first boot
# with an empty DB". This means you can add a new SEED_SUPER_ADMIN_* /
# SEED_ADMIN_* pair at ANY time (even to a database that already has other
# admins in it) and it will still be created on the next restart/deploy.
# Only fires when its EMAIL + PASSWORD are both set; leaving a pair unset
# simply skips that one (logged, does not block startup). Never overwrites
# or resets an existing account's password - if the exact email or username
# already exists, that seed is skipped entirely, every time.
# Use a strong random value for each PASSWORD, e.g.: openssl rand -base64 24
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_USERNAME=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

SEED_USER_EMAIL=
SEED_USER_USERNAME=
SEED_USER_PASSWORD=

# Legacy aliases still honored for backward compatibility with existing deploys
# (only used by the original one-time "first admin ever" bootstrap seeder,
# adminSeeder.js - prefer the SEED_SUPER_ADMIN_* names above for anything new):
# ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_USERNAME, ADMIN_NAME
