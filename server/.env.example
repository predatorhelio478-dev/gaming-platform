# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it holds live secrets.

# ---- Core ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/gaming-platform
CLIENT_URL=http://localhost:3000

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Razorpay ----
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ---- SMTP / Email ----
# All five are required for outgoing email (OTP, welcome, notifications) to work.
# If any is missing, the app logs a clear warning and skips sending - it never crashes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Seed accounts (optional) ----
# Each role is only seeded once, on first boot with an empty DB, and only if its
# EMAIL + PASSWORD are both set. Leaving these unset simply skips that seed (logged).
# Existing accounts are never overwritten or duplicated on redeploy/restart.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_USERNAME=
SEED_SUPER_ADMIN_PASSWORD=

SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

SEED_USER_EMAIL=
SEED_USER_USERNAME=
SEED_USER_PASSWORD=

# Legacy aliases still honored for backward compatibility with existing deploys:
# ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_USERNAME, ADMIN_NAME
